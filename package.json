{
  "name": "oinkbooks",
  "version": "2.0.0",
  "private": true,
  "description": "OinkBooks v2 — Angular + NestJS personal purchase tracker",
  "scripts": {
    "dev:web": "pnpm --filter @oinkbooks/web start",
    "dev:api": "pnpm --filter @oinkbooks/api start:dev",
    "dev": "pnpm run --parallel \"/^dev:(web|api)$/\"",
    "build": "pnpm --filter @oinkbooks/types build && pnpm --filter @oinkbooks/api build && pnpm --filter @oinkbooks/web build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @oinkbooks/api db:generate",
    "db:migrate": "pnpm --filter @oinkbooks/api db:migrate",
    "db:studio": "pnpm --filter @oinkbooks/api db:studio",
    "test": "pnpm --filter @oinkbooks/api test && pnpm --filter @oinkbooks/web test",
    "test:api": "pnpm --filter @oinkbooks/api test",
    "test:web": "pnpm --filter @oinkbooks/web test",
    "test:e2e": "pnpm --filter @oinkbooks/web e2e"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "bcrypt",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
