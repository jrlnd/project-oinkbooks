# Test-only fixture credentials, consumed by Playwright E2E (and any test
# scripts that want to drive the API). Copy this file to .env.test (which is
# gitignored) and fill in values — keeping the literal password out of source
# also keeps secret scanners (GitGuardian etc.) quiet.
#
# The Playwright globalSetup will register this user if it doesn't already
# exist in the local database, so any password works on first run.

TEST_USER_EMAIL=fixture@oinkbooks.test
TEST_USER_USERNAME=fixture
TEST_USER_PASSWORD=
