# Copy to .env and adjust as needed.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://oinkbooks:oinkbooks@localhost:5432/oinkbooks

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# API
API_PORT=3000
# Origin allowed for CORS (the Angular dev server)
WEB_ORIGIN=http://localhost:4200
